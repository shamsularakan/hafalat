# DAWAT | دعوات — متغيرات البيئة (نسخة تجريبية بلا أسرار حقيقية)
# انسخ هذا الملف إلى .env.local وعدّل القيم

# مسار قاعدة البيانات (SQLite للتطوير؛ الإنتاج PostgreSQL عبر طبقة الوصول)
DAWAT_DB_PATH=./data/dawat.db

# مجلد تخزين الوسائط (Object Storage محليًا؛ الإنتاج S3/R2 بروابط موقعة)
DAWAT_UPLOAD_DIR=./data/uploads

# الرابط العام للمنصة (يستخدم في روابط الدعوات وQR)
DAWAT_PUBLIC_URL=http://localhost:3000

# سر توقيع الجلسات/الروابط الموقعة (ولّد قيمة عشوائية طويلة في الإنتاج)
DAWAT_SECRET=dev-only-change-me-to-a-long-random-secret

# وضع الدفع: stub = محاكاة محلية بدون مزود حقيقي (الإنتاج: مزود معتمد + webhook موقع)
DAWAT_PAYMENT_MODE=stub

# مدة جلسة الدخول بالأيام
DAWAT_SESSION_DAYS=14

# فرض علم Secure على الكوكيز (تلقائي خلف HTTPS عبر x-forwarded-proto؛ فعّله يدويًا عند الحاجة)
DAWAT_COOKIE_SECURE=false
